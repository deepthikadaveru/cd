#include <stdio.h>
#include <string.h>
int main()
{
    char type1[10], type2[10];

    printf("Enter first operand type (int/float/char): ");
    scanf("%9s", type1);

    printf("Enter second operand type (int/float/char): ");
    scanf("%9s", type2);

    if (strcmp(type1, "int") != 0 &&
        strcmp(type1, "float") != 0 &&
        strcmp(type1, "char") != 0)
    {
        printf("Invalid type\n");
    }
    else if (strcmp(type2, "int") != 0 &&
             strcmp(type2, "float") != 0 &&
             strcmp(type2, "char") != 0)
    {
        printf("Invalid type\n");
    }
    else if (strcmp(type1, type2) == 0)
    {
        printf("Type checking successful\n");
    }
    else
    {
        printf("Type mismatch error\n");
    }

    return 0;
}
