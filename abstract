%{
#include <stdio.h>
int yylex(void);
int yyerror(const char *s);
%}

%token ID

%%
E : E '+' T { printf("Operator:+\n"); }
  | T
  ;

T : T '*' F { printf("Operator:*\n"); }
  | F
  ;

F : '(' E ')'
  | ID
  ;
%%

int main()
{
    printf("Enter expression:");
    yyparse();
    return 0;
}

int yyerror(const char *s)
{
    printf("Invalid expression\n");
