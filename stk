#include <stdio.h>
#define MAX 5

int stack[MAX], top = -1;

void push() {
    int x;
    if (top == MAX - 1)
        printf("Stack Overflow\n");
    else {
        printf("Enter value: ");
        scanf("%d", &x);
        stack[++top] = x;
        printf("Memory allocated\n");
    }
}

void pop() {
    if (top == -1)
        printf("Stack Underflow\n");
    else {
        printf("Memory deallocated: %d\n", stack[top--]);
    }
}

void display() {
    int i;
    if (top == -1)
        printf("Stack is empty\n");
    else {
        printf("Stack elements: ");
        for (i = top; i >= 0; i--)
            printf("%d ", stack[i]);
        printf("\n");
    }
}

int main() {
    int ch;
    do {
        printf("\n1.Push  2.Pop  3.Display  4.Exit\n");
        printf("Enter choice: ");
        scanf("%d", &ch);

        switch (ch) {
            case 1: push(); break;
            case 2: pop(); break;
            case 3: display(); break;
            case 4: printf("Exiting\n"); break;
            default: printf("Invalid choice\n");
        }
    } while (ch != 4);

    return 0;
}
